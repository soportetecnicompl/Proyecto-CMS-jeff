# Base de datos — en Vercel usar la connection string "pooled" (pgbouncer) de
# Neon/Vercel Postgres, no la directa, porque cada invocación serverless abre
# su propia conexión.
DATABASE_URL="postgresql://metroclub:metroclub@localhost:5432/metroclub?schema=public"
# No usado todavía por el código (no hay cliente Redis en src/); se deja
# documentado para cuando se implementen colas reales.
REDIS_URL="redis://localhost:6379"

# Secreto que valida las llamadas de Vercel Cron a /api/internal/cron/* — Vercel
# agrega automáticamente `Authorization: Bearer <CRON_SECRET>` cuando esta
# variable existe en el proyecto (ver vercel.json).
CRON_SECRET="change-me"

# Auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

# URL pública del backend (usada como base del webServiceURL de Apple Wallet)
PUBLIC_API_BASE_URL="http://localhost:3000/api"

# WhatsApp (Meta Cloud API / BSP)
WHATSAPP_BSP_API_URL=""
WHATSAPP_BSP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Apple Wallet (PassKit) — ver docs/wallet-integration.md
APPLE_PASS_TYPE_IDENTIFIER=""
APPLE_TEAM_IDENTIFIER=""
APPLE_PASS_CERT_PATH=""
APPLE_PASS_KEY_PATH=""
APPLE_PASS_CERT_PASSWORD=""
APPLE_WWDR_CERT_PATH=""

# Apple Push Notification service (updates automáticos del pass) — autenticación por token (.p8)
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_AUTH_KEY_PATH=""

# Google Wallet — ver docs/wallet-integration.md
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=""
# Logo público HTTPS requerido por Google para crear la clase de lealtad (reemplazar con el logo real de Metrocinemas)
GOOGLE_WALLET_LOGO_URL="https://placehold.co/660x660/09142e/ffffff.png?text=MetroClub"

PORT=3000
