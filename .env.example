# Configuración del servidor
PORT=3000
NODE_ENV=production

# Secreto para JWT (cambia esto por una cadena aleatoria segura)
JWT_SECRET=cambia_esto_por_una_clave_secreta_muy_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# URL base de la aplicación (sin barra al final)
APP_URL=http://localhost:3000

# Configuración de email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM=ProyectoCMS <tu_correo@gmail.com>

# Usuario administrador inicial
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=Admin123!
